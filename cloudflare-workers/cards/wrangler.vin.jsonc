{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postiqo-vin-enrichment",
  "account_id": "066b40c1b42afc714c1cbae2f6e4440f",
  "main": "src/vin-worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "VIN_ENRICHMENT_ENABLED": "true" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "postiqo-licenses",
    "database_id": "6ea78d8b-1c3f-4042-b44a-be433dbf5eff"
  }]
}
