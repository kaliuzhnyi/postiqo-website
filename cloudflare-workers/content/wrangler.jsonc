{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postiqo-website-content",
  "account_id": "066b40c1b42afc714c1cbae2f6e4440f",
  "main": "dist/index.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled":false},
  "vars": {"ADMIN_EMAILS":"i.kaliuzhnyi@icloud.com"},
  "routes": [
    {"pattern":"postiqo.io/blog*","zone_name":"postiqo.io"},
    {"pattern":"postiqo.io/sitemap.xml","zone_name":"postiqo.io"}
  ],
  "d1_databases": [{
    "binding":"CONTENT_DB",
    "database_name":"postiqo-website-content",
    "database_id":"289fc5ac-57f9-410b-a8ce-06cd0b56eefa",
    "migrations_dir":"migrations"
  }]
}
