{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postiqo-website",
  "main": "src/index.js",
  "account_id": "066b40c1b42afc714c1cbae2f6e4440f",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "postiqo.io", "custom_domain": true}],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {"name": "VIN_RATE_LIMITER", "namespace_id": "2026110201", "simple": {"limit": 20, "period": 60}},
    {"name": "VIN_PROVIDER_LIMITER", "namespace_id": "2026110202", "simple": {"limit": 60, "period": 60}}
  ]
}
